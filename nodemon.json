{
  "watch": [
    "api/index.js"
  ],
  "ext": "js,mjs,json",
  "ignore": [
    "node_modules",
    ".git",
    ".DS_Store",
    "client/**",
    "logs/**",
    "*.log",
    "api/**/*.log",
    "api/**/*.map",
    "api/**/.DS_Store",
    "api/**/tmp/**"
  ],
  "delay": "250ms",
  "exec": "node api/index.js"
}


